# Copy to .env for local development. Never commit .env or paste secrets in chat.
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data/local
MAIL_MODE=development
# For real delivery set MAIL_MODE=resend and provide both values:
RESEND_API_KEY=
MAIL_FROM=PrintsNCuts <accounts@auth.YOUR-DOMAIN.in>
# Only required to create the first admin. Set a unique 12+ character password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set only behind a trusted reverse proxy; leave off for local development.
TRUST_PROXY=0
